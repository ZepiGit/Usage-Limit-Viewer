<?xml version="1.0" encoding="utf-8"?>
<!--
  2x4: header plus per-account usage bars. Resizeable in both axes so it can grow on a
  tablet or an unfolded inner display, where more accounts fit without scrolling.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_detailed_description"
    android:previewImage="@drawable/widget_bars_preview"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:configure="com.usagelimits.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable" />
